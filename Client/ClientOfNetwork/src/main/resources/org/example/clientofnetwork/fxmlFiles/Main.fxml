<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.clientofnetwork.controller.sceneControllers.MainController">

    <!-- Center split: left list of boards, right side panel -->
    <center>
        <SplitPane dividerPositions="0.60">
            <items>
                <!-- LEFT: rows container (controller injects BoardListPane here) -->
                <ScrollPane fitToWidth="true">
                    <content>
                        <VBox fx:id="leftContainer" spacing="6">
                            <padding>
                                <Insets top="10" right="10" bottom="10" left="10"/>
                            </padding>
                        </VBox>
                    </content>
                </ScrollPane>

                <!-- RIGHT: summary + actions -->
                <VBox spacing="12">
                    <padding>
                        <Insets top="12" right="12" bottom="12" left="12"/>
                    </padding>
                    <children>
                        <Label text="Summary"/>
                        <Label fx:id="sumIndicator" style="-fx-font-size: 18;"/>
                        <Separator/>
                        <Button fx:id="createBoardBtn" text="Create Board"/>   <!-- NEW -->
                        <Button fx:id="showBoardsBtn" text="Show Boards"/>
                        <Button fx:id="logoutBtn" text="Logout"/>
                    </children>
                </VBox>
            </items>
        </SplitPane>
    </center>

    <!-- Bottom status bar -->
    <bottom>
        <HBox spacing="8">
            <padding>
                <Insets top="8" right="10" bottom="8" left="10"/>
            </padding>
            <children>
                <Label text="Status:"/>
                <Label fx:id="statusLabel"/>
            </children>
        </HBox>
    </bottom>

</BorderPane>
